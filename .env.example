# Copy to .env to override defaults. Any setting in app/config.py can be set here.
DATABASE_URL=sqlite:///./controlplane.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/controlplane

# Signs login tokens. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset, a random secret is used and every login resets when the server restarts.
# JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
